{
  "name": "raiden-embed-view",
  "version": "1.0.19",
  "main": "dist/embed-serv.js",
  "scripts": {
    "dev": "bun --watch src/embed-serv.ts",
    "start": "bun src/embed-serv.ts",
    "build": "eslint src --ext .ts && bun build src/embed-serv.ts --outdir dist --target node",
    "pm2:start": "bun run build && pm2 start ecosystem.config.js --env production",
    "dp": "git pull && bun run build && pm2 reload ecosystem.config.js --env production",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:ci": "bun test --coverage"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ts-node": "^10.9.1"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "eslint": "^8.49.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.6"
  }
}